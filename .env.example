# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 저장소에 올라가지 않습니다.
#
#     cp .env.example .env
#
# 세션 서명 키 — 반드시 바꿔야 합니다.
# 이 값을 아는 사람은 남의 로그인 세션을 만들어낼 수 있습니다.
# 만드는 법 (아무 PC 에서):
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
MAJUNG_SECRET=

# 밖에서 접속하는 주소. 초대 QR 과 링크가 이 주소로 만들어집니다.
# 비워두면 원내망 주소(192.168.x.x)를 안내합니다 — 시험용입니다.
MAJUNG_PUBLIC_URL=https://majung.aurabus.co.kr

# 앞에 우리가 세운 프록시가 몇 대인가. DSM 역방향 프록시 한 대면 1.
MAJUNG_PROXY_HOPS=1

# 화면의 결 — 비워두면 기본(숲). mist · moss · blank
MAJUNG_SKIN=

# 자료 폴더의 주인 번호. DSM 에서 만든 공유 폴더의 주인과 맞춥니다.
# NAS 에 SSH 로 들어가 `id 사용자이름` 으로 확인할 수 있습니다.
MAJUNG_UID=1000
MAJUNG_GID=1000
