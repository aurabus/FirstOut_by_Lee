# 이 파일을 .env 로 복사해서 값을 채우세요.
#
#     cp .env.example .env
#
# .env 는 저장소에 올라가지 않습니다 (.gitignore 로 막혀 있습니다).
# 여기 적는 값은 남에게 보여주면 안 되는 것들입니다.


# ── 손잡고 마중 ────────────────────────────────────────────────

# 세션 서명 키 — 반드시 바꿔야 합니다.
# 이 값을 아는 사람은 남의 로그인 세션을 만들어낼 수 있습니다.
# 만드는 법 (아무 PC 에서 한 줄):
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
MAJUNG_SECRET=

# 밖에서 접속하는 주소. 초대 QR 과 링크가 이 주소로 만들어집니다.
# 비워두면 원내망 주소(192.168.x.x)를 안내합니다 — 시험용입니다.
MAJUNG_PUBLIC_URL=https://majung.aurabus.com

# 앞에 우리가 세운 프록시가 몇 대인가.
# DSM 역방향 프록시 한 대를 거치므로 1 입니다. 그대로 두세요.
MAJUNG_PROXY_HOPS=1

# 화면의 결 — 비워두면 기본(숲). mist · moss · blank
MAJUNG_SKIN=

# 자료 폴더의 주인 번호. NAS 에 SSH 로 들어가 `id 사용자이름` 으로 확인합니다.
#     uid=1026(aurabus) gid=100(users)  →  아래에 1026 과 100 을 적습니다
MAJUNG_UID=1000
MAJUNG_GID=1000
